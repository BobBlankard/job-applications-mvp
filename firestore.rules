rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===========================================================
    // Shared project: PinHaus marketplace + Job Applications MVP
    // Job Applications data lives under users/{uid}/applications|resumes|coverLetters
    // ===========================================================

    // Users collection (PinHaus profiles + optional Job Apps email/createdAt seed)
    match /users/{userId} {
      // Allow reading any user profile (authenticated)
      // OR allow username checks (unauthenticated but limited query)
      allow read: if request.auth != null ||
        (request.query.limit <= 1 &&
         request.query.filters.size() == 1 &&
         request.query.filters[0].fieldPath == "username");

      // Allow writing own profile (authenticated)
      allow write: if request.auth != null && request.auth.uid == userId;

      // Liked items subcollection - users can read/write their own liked items
      match /likedItems/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Saved Cards (PinHaus)
      match /savedCards/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ---- Job Applications MVP (owner-only) ----
      match /applications/{applicationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /resumes/{resumeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /coverLetters/{coverLetterId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Boards collection - users can read all, owners can create/update/delete
    match /boards/{boardId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // Items collection - users can read all items, write their own
    match /items/{itemId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.seller == request.auth.uid;
      allow delete: if request.auth != null && resource.data.seller == request.auth.uid;
      // Allow authenticated users to update only the likedCount field
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedCount']);
      // Allow buyers to update sold status fields when purchasing
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isSold', 'buyerId', 'soldAt', 'shippingStatus', 'trackingNumber']);
    }

    // Conversations collection - basic authenticated access (tighten later)
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // Offers collection - users can read/write offers they're involved in
    match /offers/{offerId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.buyerId;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
    }

    // Orders collection - users can read/write orders they're involved in
    match /orders/{orderId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.buyerId;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);

      match /history/{historyId} {
        allow read, write: if request.auth != null &&
          (request.auth.uid == get(/databases/$(database)/documents/orders/$(orderId)).data.buyerId ||
           request.auth.uid == get(/databases/$(database)/documents/orders/$(orderId)).data.sellerId);
      }
    }

    // User Behaviors collection
    match /userBehaviors/{behaviorId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }

    // Tax Rates collection
    match /taxRates/{sellerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == sellerId;
    }

    // Shipping Rates collection
    match /shippingRates/{sellerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == sellerId;
    }

    // Shipping Addresses collection
    match /shippingAddresses/{userId}/addresses/{addressId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reviewerId;
      allow update: if request.auth != null && request.auth.uid == resource.data.reviewerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.reviewerId;
    }

    // Default rule - deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
